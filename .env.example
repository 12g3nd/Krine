# Copy this file to `.env` and fill in real values.
# Never commit a populated .env to version control.

# --- Django core ---

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set to False in production.
DEBUG=True

# Comma-separated list of hostnames Django will serve.
# Examples: localhost,127.0.0.1   or   example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF (include scheme).
# Examples: http://localhost:8000   or   https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Set to True only when terminating TLS at an upstream proxy
# (Cloudflare, nginx, a load balancer) that sets X-Forwarded-Proto.
# Leaving this False on a directly-exposed server is safer.
BEHIND_PROXY=False

# --- Database ---
# Defaults to a local SQLite file if DATABASE_URL is unset.
# For Postgres: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Postgres credentials used by docker-compose to provision the db container.
# Only required if you're running the bundled docker-compose stack.
POSTGRES_DB=krine
POSTGRES_USER=krine
POSTGRES_PASSWORD=

# --- Redis (optional) ---
# Used as Django's cache backend when set. Falls back to in-memory cache otherwise.
# Example: redis://redis:6379/1
REDIS_URL=

# --- AI moderation ---
# False -> load the model locally via transformers (needs RAM, no API key).
# True  -> call the HuggingFace Inference API (needs HUGGINGFACE_API_KEY).
USE_AI_API=False

# Required only when USE_AI_API=True. Get a token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# --- Observability (optional) ---
# Sentry project DSN. Leave empty to disable.
SENTRY_DSN=

# Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Leave empty to omit the tag.
GOOGLE_ANALYTICS_ID=

# --- Object storage (optional) ---
# Set USE_S3=True to serve static/media from an S3-compatible bucket
# (AWS S3, DigitalOcean Spaces, Backblaze B2, etc.).
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
