# Copy this file to `.env` and fill in real values.
# Never commit a populated .env to version control.

# --- Django core ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
BEHIND_PROXY=False

# --- Archive mode ---
# True seals writes and presents the Django app as a read-only record.
# The static exporter enables this automatically while rendering.
ARCHIVE_MODE=False
ARCHIVE_OPENED_DATE=
ARCHIVE_CLOSED_DATE=
ARCHIVE_SITE_URL=https://krine.ca

# --- Database ---
DATABASE_URL=
POSTGRES_DB=krine
POSTGRES_USER=krine
POSTGRES_PASSWORD=

# --- Redis (optional) ---
REDIS_URL=

# --- AI moderation ---
USE_AI_API=False
HUGGINGFACE_API_KEY=

# --- Observability (optional) ---
SENTRY_DSN=
GOOGLE_ANALYTICS_ID=

# --- Object storage (optional) ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
